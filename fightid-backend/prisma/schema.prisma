generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AMATEUR
  PRO
  FEDERATION_REP
  ADMIN
}

enum WeightClass {
  STRAWWEIGHT
  FLYWEIGHT
  BANTAMWEIGHT
  FEATHERWEIGHT
  LIGHTWEIGHT
  WELTERWEIGHT
  MIDDLEWEIGHT
  LIGHT_HEAVYWEIGHT
  HEAVYWEIGHT
}

enum FightResult {
  WIN
  LOSS
  DRAW
  NO_CONTEST
}

enum FightMethod {
  KO_TKO
  SUBMISSION
  DECISION
  DQ
  OTHER
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  CANCELLED
  COMPLETED
}

enum RuleSet {
  MMA
  GRAPPLING
  BOXING
  MUAY_THAI
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  CHALLENGE_RECEIVED
  CHALLENGE_ACCEPTED
  CHALLENGE_DECLINED
  PRO_APPROVED
  PRO_REJECTED
  FIGHT_CONFIRMED
  RANK_CHANGE
  FIGHTER_WON
  BADGE_EARNED
  MIC_CHECK_POSTED
}

enum CardTier {
  BRONZE
  SILVER
  GOLD
  CHAMPION
}

enum TrainingType {
  STRIKING
  GRAPPLING
  CONDITIONING
  SPARRING
  DRILLING
  RECOVERY
  OTHER
}

enum TournamentStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum BadgeType {
  FIRST_WIN
  FIRST_KO
  FIRST_SUBMISSION
  WIN_STREAK_3
  WIN_STREAK_5
  WIN_STREAK_10
  UNDEFEATED
  VETERAN_10_FIGHTS
  VETERAN_25_FIGHTS
  KO_SPECIALIST
  SUBMISSION_SPECIALIST
  DECISION_MASTER
  POINTS_500
  POINTS_1000
  POINTS_2000
  PLATFORM_PIONEER
}

enum EmailCodePurpose {
  LOGIN
  REGISTER
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         UserRole  @default(AMATEUR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  fighterProfile FighterProfile?
  federation      Federation?
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  emailCodes      EmailVerificationCode[]
  cardCollections CardCollection[]
  cornerMen        CornerMan[]
  gymsOwned        Gym[]              @relation("GymOwner")
  tournaments      Tournament[]
  micCheckReactions MicCheckReaction[]

  @@index([role])
}

model EmailVerificationCode {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  codeHash  String
  purpose   EmailCodePurpose
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FighterProfile {
  id                     String      @id @default(uuid()) @db.Uuid
  userId                 String      @unique @db.Uuid
  fullName               String
  nickname               String?
  dateOfBirth            DateTime
  country                String
  weightClass            WeightClass
  gym                    String?
  bio                    String?
  profilePhotoUrl        String?
  coverPhotoUrl          String?
  instagramUrl           String?
  youtubeUrl             String?
  gymId                  String?      @db.Uuid
  seekingSparring        Boolean      @default(false)
  sparringLocation       String?
  sparringNote           String?
  isVerifiedPro          Boolean     @default(false)
  verifiedByFederationId String?     @db.Uuid
  points                 Int         @default(0)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymProfile           Gym?                     @relation("FighterGymRelation", fields: [gymId], references: [id], onDelete: SetNull)
  verifiedByFederation Federation?              @relation("FederationVerifiedFighters", fields: [verifiedByFederationId], references: [id], onDelete: SetNull)
  fights               Fight[]                  @relation("FighterFightRecords")
  opponentFights       Fight[]                  @relation("OpponentPlatformFights")
  sentChallenges       Challenge[]              @relation("SentChallenges")
  receivedChallenges   Challenge[]              @relation("ReceivedChallenges")
  resultSubmissions    Challenge[]              @relation("ChallengeResultSubmitter")
  verificationRequests ProVerificationRequest[]
  fighterCard          FighterCard?
  cornerMen            CornerMan[]
  fightSeeks           FightSeek[]
  trainingLogs         TrainingLog[]
  badges               FighterBadge[]
  tournamentFighter1   TournamentMatch[]        @relation("TMatchFighter1")
  tournamentFighter2   TournamentMatch[]        @relation("TMatchFighter2")
  tournamentWins       TournamentMatch[]        @relation("TMatchWinner")
  micChecks            MicCheck[]

  @@index([fullName])
  @@index([country])
  @@index([gymId])
  @@index([weightClass])
  @@index([seekingSparring])
  @@index([isVerifiedPro, weightClass, points])
}

model Federation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  country   String
  repUserId String   @unique @db.Uuid
  createdAt DateTime @default(now())

  repUser              User                     @relation(fields: [repUserId], references: [id], onDelete: Cascade)
  verifiedFighters     FighterProfile[]         @relation("FederationVerifiedFighters")
  verificationRequests ProVerificationRequest[]

  @@index([country])
}

model Fight {
  id                String      @id @default(uuid()) @db.Uuid
  fighterId         String      @db.Uuid
  opponentName      String
  opponentProfileId String?     @db.Uuid
  eventName         String
  fightDate         DateTime
  result            FightResult
  method            FightMethod
  round             Int
  fightTime         String
  isVerified        Boolean     @default(false)
  highlightUrl      String?
  createdAt         DateTime    @default(now())

  fighter         FighterProfile  @relation("FighterFightRecords", fields: [fighterId], references: [id], onDelete: Cascade)
  opponentProfile FighterProfile? @relation("OpponentPlatformFights", fields: [opponentProfileId], references: [id], onDelete: SetNull)

  @@index([fighterId])
  @@index([opponentProfileId])
  @@index([fightDate])
  @@index([isVerified])
}

model Challenge {
  id                String          @id @default(uuid()) @db.Uuid
  senderId          String          @db.Uuid
  receiverId        String          @db.Uuid
  status            ChallengeStatus @default(PENDING)
  proposedDateFrom  DateTime
  proposedDateTo    DateTime
  location          String
  weightClass       WeightClass
  ruleSet           RuleSet
  senderMessage     String?
  counterOffer      String?
  resultSubmittedBy String?         @db.Uuid
  resultConfirmed   Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  sender            FighterProfile  @relation("SentChallenges", fields: [senderId], references: [id], onDelete: Cascade)
  receiver          FighterProfile  @relation("ReceivedChallenges", fields: [receiverId], references: [id], onDelete: Cascade)
  resultSubmitter   FighterProfile? @relation("ChallengeResultSubmitter", fields: [resultSubmittedBy], references: [id], onDelete: SetNull)
  micChecks         MicCheck[]

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model FighterCard {
  id         String   @id @default(uuid()) @db.Uuid
  fighterId String   @unique @db.Uuid
  tier       CardTier
  createdAt  DateTime @default(now())

  fighter    FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  collectors CardCollection[]

  @@index([tier])
}

model CardCollection {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  cardId      String   @db.Uuid
  collectedAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  card FighterCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

model CornerMan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  fighterId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fighter FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@unique([userId, fighterId])
  @@index([fighterId])
  @@index([userId])
}

model FightSeek {
  id          String      @id @default(uuid()) @db.Uuid
  fighterId   String      @db.Uuid
  weightClass WeightClass
  ruleSet     RuleSet
  location    String
  dateFrom    DateTime
  dateTo      DateTime
  message     String?
  expiresAt   DateTime
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  fighter FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@index([weightClass])
  @@index([ruleSet])
  @@index([isActive, expiresAt])
  @@index([fighterId])
}

model TrainingLog {
  id           String       @id @default(uuid()) @db.Uuid
  fighterId    String       @db.Uuid
  type         TrainingType
  durationMins Int
  note         String?
  date         DateTime     @default(now())
  createdAt    DateTime     @default(now())

  fighter FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@index([fighterId, date])
}

model Tournament {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  weightClass WeightClass
  ruleSet     RuleSet
  status      TournamentStatus @default(UPCOMING)
  size        Int
  createdById String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  matches   TournamentMatch[]

  @@index([status])
  @@index([weightClass])
  @@index([createdById])
}

model TournamentMatch {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String    @db.Uuid
  round        Int
  matchNumber  Int
  fighter1Id   String?   @db.Uuid
  fighter2Id   String?   @db.Uuid
  winnerId     String?   @db.Uuid
  scheduledAt  DateTime?
  completedAt  DateTime?

  tournament Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fighter1   FighterProfile? @relation("TMatchFighter1", fields: [fighter1Id], references: [id], onDelete: SetNull)
  fighter2   FighterProfile? @relation("TMatchFighter2", fields: [fighter2Id], references: [id], onDelete: SetNull)
  winner     FighterProfile? @relation("TMatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, matchNumber])
  @@index([tournamentId])
  @@index([fighter1Id])
  @@index([fighter2Id])
  @@index([winnerId])
}

model FighterBadge {
  id        String    @id @default(uuid()) @db.Uuid
  fighterId String    @db.Uuid
  type      BadgeType
  earnedAt  DateTime  @default(now())

  fighter FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@unique([fighterId, type])
  @@index([fighterId])
}

model Gym {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  country     String
  city        String
  logoUrl     String?
  description String?
  websiteUrl  String?
  ownerId     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User?            @relation("GymOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  fighters FighterProfile[] @relation("FighterGymRelation")

  @@index([country])
  @@index([name])
  @@index([ownerId])
}

model MicCheck {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @db.Uuid
  fighterId   String   @db.Uuid
  message     String
  videoUrl    String?
  createdAt   DateTime @default(now())

  challenge Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  fighter   FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  reactions MicCheckReaction[]

  @@unique([challengeId, fighterId])
  @@index([challengeId])
  @@index([fighterId])
  @@index([createdAt])
}

model MicCheckReaction {
  id         String   @id @default(uuid()) @db.Uuid
  micCheckId String   @db.Uuid
  userId     String   @db.Uuid
  emoji      String
  createdAt  DateTime @default(now())

  micCheck MicCheck @relation(fields: [micCheckId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([micCheckId, userId])
  @@index([micCheckId])
  @@index([userId])
}

model ProVerificationRequest {
  id           String             @id @default(uuid()) @db.Uuid
  fighterId    String             @db.Uuid
  federationId String             @db.Uuid
  status       VerificationStatus @default(PENDING)
  documentUrl  String
  adminNote    String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  fighter    FighterProfile @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  federation Federation      @relation(fields: [federationId], references: [id], onDelete: Cascade)

  @@index([fighterId])
  @@index([federationId])
  @@index([status])
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            NotificationType
  message         String
  isRead          Boolean          @default(false)
  relatedEntityId String?
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
}
